# Copy to .env and adjust. Every variable is optional in development;
# values shown are the built-in defaults unless noted otherwise.

# --- Application -------------------------------------------------------
# "production" disables Swagger UI and makes the JWT secrets mandatory.
NODE_ENV=development
PORT=3000
# winston level: error | warn | info | verbose | debug
LOG_LEVEL=info

# --- PostgreSQL (used by the app and by sequelize-cli migrations) -------
DB_HOST=localhost
DB_PORT=5432
DB_USER=oneid
DB_PASSWORD=oneid
DB_NAME=oneid
# Log every SQL statement at debug level.
DB_LOGGING=false
# Connect over TLS.
DB_SSL=false
# With DB_SSL=true, verify the server certificate (set to false only for
# servers with self-signed certificates you trust).
DB_SSL_REJECT_UNAUTHORIZED=true

# --- JWT -----------------------------------------------------------------
# Required when NODE_ENV=production. Use two different long random values,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
# Development fallbacks are used when these are empty.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Lifetimes as seconds ("900") or with a unit: s, m, h, d.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Written to and verified against the "iss" / "aud" claims.
JWT_ISSUER=one-id
JWT_AUDIENCE=one-id-clients
